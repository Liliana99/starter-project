rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(authorId) {
      return request.auth != null && request.auth.uid == authorId;
    }


    // Allow unauthenticated read access to public data
    match /articles/{articleId} {
      allow read: if true; // Public read
      allow create: if request.auth != null 
                    && request.resource.data.author_id == request.auth.uid
                    && request.resource.data.content.size() <= 50000; // Validation of 50k chars
      allow update, delete: if isOwner(resource.data.author_id);
    }

   match /authors/{authorId} {
      allow read: if true;
      allow write: if isOwner(authorId); // Only the journalist edits their own bio
    }

    match /comments/{commentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if request.auth != null; // Allow creation to logged in users
    }
  }
}